<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>基本情報技術者試験 クイズ道場</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Kaku Gothic ProN", "Hiragino Sans", Meiryo, sans-serif;
            background-color: #f4f5f7;
            color: #333333;
            line-height: 1.6;
            padding: 16px 12px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
        }

        header {
            background-color: #2b5797;
            color: #ffffff;
            padding: 15px 20px;
            border-bottom: 4px solid #1e3a66;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header h1 {
            font-size: 1.2rem;
            font-weight: bold;
        }

        .mode-badge {
            background-color: #d9534f;
            color: #ffffff;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: bold;
            display: none;
        }

        .file-select-area {
            padding: 24px 16px;
            background-color: #eef2f7;
            border-bottom: 1px solid #dcdcdc;
            text-align: center;
        }

        .file-select-area p {
            margin-bottom: 12px;
            font-weight: bold;
            color: #444;
            font-size: 0.95rem;
        }

        input[type="file"] {
            display: inline-block;
            padding: 10px 14px;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            max-width: 100%;
        }

        .quiz-area {
            padding: 18px;
            display: none;
        }

        .status-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #f8f9fa;
            padding: 8px 12px;
            border-radius: 4px;
            border: 1px solid #e9ecef;
            margin-bottom: 16px;
            font-size: 0.9rem;
            font-weight: bold;
            color: #555;
        }

        .question-title {
            font-size: 1.05rem;
            font-weight: bold;
            margin-bottom: 12px;
            border-bottom: 2px solid #2b5797;
            padding-bottom: 4px;
            color: #2b5797;
        }

        .question-text {
            font-size: 1rem;
            margin-bottom: 20px;
            background-color: #fafafa;
            padding: 14px;
            border-left: 4px solid #2b5797;
            border-radius: 4px;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .options-list {
            list-style: none;
            margin-bottom: 20px;
        }

        .option-btn {
            width: 100%;
            text-align: left;
            background-color: #ffffff;
            border: 1px solid #cccccc;
            border-radius: 6px;
            padding: 12px 14px;
            margin-bottom: 10px;
            font-size: 0.95rem;
            cursor: pointer;
            transition: background-color 0.15s, border-color 0.15s;
            display: flex;
            align-items: flex-start;
            -webkit-tap-highlight-color: transparent;
        }

        .option-btn:active:not(:disabled) {
            background-color: #e8f0fe;
        }

        .option-label {
            font-weight: bold;
            display: inline-block;
            width: 28px;
            height: 28px;
            line-height: 26px;
            text-align: center;
            border: 1px solid #666;
            border-radius: 4px;
            margin-right: 10px;
            background-color: #fff;
            flex-shrink: 0;
        }

        .option-text {
            padding-top: 2px;
            word-break: break-word;
        }

        .option-btn.correct-choice {
            background-color: #d4edda !important;
            border-color: #28a745 !important;
            color: #155724;
        }

        .option-btn.correct-choice .option-label {
            background-color: #28a745;
            color: #fff;
            border-color: #28a745;
        }

        .option-btn.wrong-choice {
            background-color: #f8d7da !important;
            border-color: #dc3545 !important;
            color: #721c24;
        }

        .option-btn.wrong-choice .option-label {
            background-color: #dc3545;
            color: #fff;
            border-color: #dc3545;
        }

        .result-area {
            display: none;
            margin-top: 18px;
            padding: 16px;
            border-radius: 6px;
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
        }

        .result-header {
            font-size: 1.15rem;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .result-header.correct {
            color: #28a745;
        }

        .result-header.wrong {
            color: #dc3545;
        }

        .explanation-box {
            background-color: #ffffff;
            border: 1px solid #cccccc;
            padding: 12px;
            border-radius: 4px;
            margin-top: 8px;
            margin-bottom: 16px;
            font-size: 0.95rem;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .explanation-title {
            font-weight: bold;
            color: #333;
            margin-bottom: 6px;
            border-bottom: 1px solid #eee;
            padding-bottom: 3px;
        }

        .nav-actions {
            text-align: right;
        }

        .next-btn {
            background-color: #2b5797;
            color: #ffffff;
            border: none;
            padding: 12px 24px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
        }

        .completion-area {
            display: none;
            padding: 36px 20px;
            text-align: center;
        }

        .completion-area h2 {
            font-size: 1.6rem;
            color: #2b5797;
            margin-bottom: 12px;
        }

        .score-display {
            font-size: 1.2rem;
            margin-bottom: 24px;
        }

        .action-btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            border: none;
            padding: 12px 20px;
            font-size: 1rem;
            font-weight: bold;
            border-radius: 6px;
            cursor: pointer;
            width: 100%;
        }

        .btn-review {
            background-color: #d9534f;
            color: #fff;
        }

        .btn-restart {
            background-color: #28a745;
            color: #fff;
        }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>基本情報技術者試験 クイズ道場</h1>
        <span class="mode-badge" id="modeBadge">復習モード</span>
    </header>

    <!-- ファイル読み込みエリア -->
    <div class="file-select-area" id="fileSelectArea">
        <p>演習を開始するにはCSVファイルを選択してください</p>
        <input type="file" id="csvFileInput" accept=".csv">
    </div>

    <!-- クイズエリア -->
    <div class="quiz-area" id="quizArea">
        <div class="status-bar">
            <span id="progressText">第 1 問 / 全 0 問</span>
            <span id="scoreRateText">正答率: 0.0%</span>
        </div>

        <div class="question-title" id="questionTitle">第 1 問</div>
        <div class="question-text" id="questionText">問題文</div>

        <ul class="options-list" id="optionsList"></ul>

        <!-- 回答後の結果・解説表示エリア -->
        <div class="result-area" id="resultArea">
            <div class="result-header" id="resultHeader">正解！</div>
            <div class="explanation-box">
                <div class="explanation-title">【解説】</div>
                <div id="explanationText">解説文</div>
            </div>
            <div class="nav-actions">
                <button class="next-btn" id="nextBtn" onclick="nextQuestion()">次の問題へ</button>
            </div>
        </div>
    </div>

    <!-- 完了画面 -->
    <div class="completion-area" id="completionArea">
        <h2 id="completionTitle">演習完了！</h2>
        <div class="score-display" id="finalScoreText">全 0 問中 0 問正解 (正答率 0%)</div>
        <div class="action-btn-group">
            <button class="btn btn-review" id="reviewBtn" onclick="startReviewMode()" style="display: none;">間違えた問題を見直す</button>
            <button class="btn btn-restart" onclick="restartQuiz()">最初から全問解き直す</button>
        </div>
    </div>
</div>

<script>
    let originalQuizData = [];
    let currentQuizSet = [];
    let wrongQuizList = [];
    
    let currentIndex = 0;
    let correctAnswersCount = 0;
    let isAnswered = false;
    let isReviewMode = false;
    let currentShuffledOptions = [];

    document.getElementById('csvFileInput').addEventListener('change', handleFileSelect);

    function parseCSV(text) {
        const lines = [];
        let row = [];
        let current = '';
        let inQuotes = false;

        for (let i = 0; i < text.length; i++) {
            const char = text[i];
            const nextChar = text[i + 1];

            if (char === '"') {
                if (inQuotes && nextChar === '"') {
                    current += '"';
                    i++;
                } else {
                    inQuotes = !inQuotes;
                }
            } else if (char === ',' && !inQuotes) {
                row.push(current.trim());
                current = '';
            } else if ((char === '\r' || char === '\n') && !inQuotes) {
                if (char === '\r' && nextChar === '\n') {
                    i++;
                }
                row.push(current.trim());
                if (row.length > 1 || row[0] !== '') {
                    lines.push(row);
                }
                row = [];
                current = '';
            } else {
                current += char;
            }
        }
        if (current !== '' || row.length > 0) {
            row.push(current.trim());
            lines.push(row);
        }
        return lines;
    }

    function handleFileSelect(event) {
        const file = event.target.files[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = function(e) {
            const content = e.target.result;
            const parsedData = parseCSV(content);

            if (parsedData.length < 2) {
                alert('有効なデータが含まれていないCSVファイルです。');
                return;
            }

            originalQuizData = [];
            for (let i = 1; i < parsedData.length; i++) {
                const row = parsedData[i];
                if (row.length >= 6) {
                    originalQuizData.push({
                        question: row[0],
                        correct: row[1],
                        dummies: [row[2], row[3], row[4]],
                        explanation: row[5]
                    });
                }
            }

            if (originalQuizData.length === 0) {
                alert('CSVファイルの列形式が正しくありません。\n「問題文, 正解の選択肢, 不正解の選択肢1, 不正解の選択肢2, 不正解の選択肢3, 解説文」の順に設定してください。');
                return;
            }

            restartQuiz();
            document.getElementById('fileSelectArea').style.display = 'none';
            document.getElementById('quizArea').style.display = 'block';
        };

        reader.readAsText(file, 'UTF-8');
    }

    function shuffleArray(array) {
        for (let i = array.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [array[i], array[j]] = [array[j], array[i]];
        }
    }

    function loadQuestion() {
        isAnswered = false;
        const currentQuiz = currentQuizSet[currentIndex];

        document.getElementById('progressText').textContent = `第 ${currentIndex + 1} 問 / 全 ${currentQuizSet.length} 問`;
        document.getElementById('questionTitle').textContent = `第 ${currentIndex + 1} 問`;
        document.getElementById('questionText').textContent = currentQuiz.question;
        document.getElementById('resultArea').style.display = 'none';

        const answeredCount = currentIndex;
        const rate = answeredCount === 0 ? 0 : ((correctAnswersCount / answeredCount) * 100).toFixed(1);
        document.getElementById('scoreRateText').textContent = `正答率: ${rate}%`;

        const options = [
            { text: currentQuiz.correct, isCorrect: true },
            { text: currentQuiz.dummies[0], isCorrect: false },
            { text: currentQuiz.dummies[1], isCorrect: false },
            { text: currentQuiz.dummies[2], isCorrect: false }
        ];

        shuffleArray(options);
        currentShuffledOptions = options;

        const optionsList = document.getElementById('optionsList');
        optionsList.innerHTML = '';
        const labels = ['ア', 'イ', 'ウ', 'エ'];

        options.forEach((opt, idx) => {
            const li = document.createElement('li');
            const button = document.createElement('button');
            button.className = 'option-btn';
            button.onclick = () => selectOption(idx);

            const labelSpan = document.createElement('span');
            labelSpan.className = 'option-label';
            labelSpan.textContent = labels[idx];

            const textSpan = document.createElement('span');
            textSpan.className = 'option-text';
            textSpan.textContent = opt.text;

            button.appendChild(labelSpan);
            button.appendChild(textSpan);
            li.appendChild(button);
            optionsList.appendChild(li);
        });
    }

    function selectOption(selectedIndex) {
        if (isAnswered) return;
        isAnswered = true;

        const currentQuiz = currentQuizSet[currentIndex];
        const selectedOption = currentShuffledOptions[selectedIndex];
        const optionButtons = document.querySelectorAll('.option-btn');

        optionButtons.forEach(btn => btn.disabled = true);

        const resultHeader = document.getElementById('resultHeader');
        if (selectedOption.isCorrect) {
            correctAnswersCount++;
            resultHeader.className = 'result-header correct';
            resultHeader.textContent = '正解！';
            optionButtons[selectedIndex].classList.add('correct-choice');
        } else {
            wrongQuizList.push(currentQuiz);
            resultHeader.className = 'result-header wrong';
            resultHeader.textContent = '不正解...';
            optionButtons[selectedIndex].classList.add('wrong-choice');

            currentShuffledOptions.forEach((opt, idx) => {
                if (opt.isCorrect) {
                    optionButtons[idx].classList.add('correct-choice');
                }
            });
        }

        document.getElementById('explanationText').textContent = currentQuiz.explanation;
        document.getElementById('resultArea').style.display = 'block';

        const rate = (((correctAnswersCount) / (currentIndex + 1)) * 100).toFixed(1);
        document.getElementById('scoreRateText').textContent = `正答率: ${rate}%`;
    }

    function nextQuestion() {
        currentIndex++;
        if (currentIndex < currentQuizSet.length) {
            loadQuestion();
        } else {
            showCompletionScreen();
        }
    }

    function showCompletionScreen() {
        document.getElementById('quizArea').style.display = 'none';
        document.getElementById('completionArea').style.display = 'block';

        const total = currentQuizSet.length;
        const rate = ((correctAnswersCount / total) * 100).toFixed(1);

        document.getElementById('completionTitle').textContent = isReviewMode ? '復習完了！' : '演習完了！';
        document.getElementById('finalScoreText').textContent = `全 ${total} 問中 ${correctAnswersCount} 問正解 (正答率 ${rate}%)`;

        const reviewBtn = document.getElementById('reviewBtn');
        if (wrongQuizList.length > 0) {
            reviewBtn.style.display = 'block';
            reviewBtn.textContent = `間違えた ${wrongQuizList.length} 問を見直す`;
        } else {
            reviewBtn.style.display = 'none';
        }
    }

    function startReviewMode() {
        isReviewMode = true;
        document.getElementById('modeBadge').style.display = 'inline-block';

        currentQuizSet = [...wrongQuizList];
        wrongQuizList = [];

        shuffleArray(currentQuizSet);
        currentIndex = 0;
        correctAnswersCount = 0;

        document.getElementById('completionArea').style.display = 'none';
        document.getElementById('quizArea').style.display = 'block';
        loadQuestion();
    }

    function restartQuiz() {
        isReviewMode = false;
        document.getElementById('modeBadge').style.display = 'none';

        currentQuizSet = [...originalQuizData];
        wrongQuizList = [];

        shuffleArray(currentQuizSet);
        currentIndex = 0;
        correctAnswersCount = 0;

        document.getElementById('completionArea').style.display = 'none';
        document.getElementById('quizArea').style.display = 'block';
        loadQuestion();
    }
</script>

</body>
</html>
